############################################################
# Supervisor 실습용 환경변수 예시
#
# 사용법:
# 1) 이 파일을 supervisor/.env 로 복사
# 2) 값 채우고 `supervisor/csv_supervisor.ipynb` 실행
############################################################

# ===== OpenRouter (LLM) =====
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# ===== Langfuse (self-hosted) =====
# 이 리포의 `langfuse/docker-compose.yml` 기본 포트 매핑:
# - Langfuse Web UI: http://localhost:3001
# 노트북/파이썬 SDK에서는 아래 host/base_url 값을 사용합니다.
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# (선택) Langfuse 환경/릴리즈 태그
LANGFUSE_ENVIRONMENT=local
LANGFUSE_RELEASE=csv-supervisor


